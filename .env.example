# ==============================================================================
# AgriVoice - Environment Variables Template (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - All credentials and secrets below are INSECURE LOCAL-DEVELOPMENT-ONLY DEFAULTS.
# - NEVER use these default passwords, tokens, or secret strings in staging or production.
# - In production, generate strong cryptographic secrets and inject via environment/secrets manager.
# - Copy this file to .env for local development and supply your actual credentials.
# ==============================================================================

# --- Node.js Backend API Service ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# [LOCAL-DEVELOPMENT-ONLY DEFAULT] Replace with a cryptographically secure 64+ char random string in production
APP_SECRET=dev_insecure_jwt_secret_do_not_use_in_production_min32chars
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL & PostGIS Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrivoice
# [LOCAL-DEVELOPMENT-ONLY DEFAULTS] Insecure default credentials strictly for local developer workstation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrivoice

# --- Python AI Service ---
AI_SERVICE_HOST=localhost
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_api_key_placeholder
GEMINI_API_KEY=your_gemini_api_key_placeholder
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder

# --- Telephony & Voice AI Integration ---
TELEPHONY_PROVIDER=exotel
TELEPHONY_API_KEY=your_telephony_api_key_placeholder
TELEPHONY_API_TOKEN=your_telephony_api_token_placeholder
TELEPHONY_ACCOUNT_SID=your_telephony_account_sid_placeholder
TELEPHONY_VIRTUAL_NUMBER=+910000000000
WEBHOOK_BASE_URL=https://your-domain.ngrok-free.app

# --- Regional Speech Services (ASR / TTS) ---
ASR_PROVIDER=bhashini_or_whisper_or_google
TTS_PROVIDER=bhashini_or_elevenlabs_or_azure
SPEECH_API_KEY=your_speech_api_key_placeholder

# --- External Meteorological & Agricultural APIs ---
WEATHER_API_KEY=your_weather_api_key_placeholder
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1
GOV_DATA_API_KEY=your_gov_data_api_key_placeholder
