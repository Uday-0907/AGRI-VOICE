# ==============================================================================
# AgriVoice - Root .gitignore
# ==============================================================================

# --- Environment & Sensitive Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
service-account*.json
*.token

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Node.js / Frontend / Backend API ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
dist-ssr/
build/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.turbo/

# --- Python / AI Service ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- Databases & Persistent Local Storage ---
*.sqlite
*.sqlite3
*.db
data/postgres/

# --- Audio / Media / Uploads Cache ---
*.wav
*.mp3
*.ogg
*.flac
uploads/
recordings/
temp/
tmp/

# --- Logs ---
logs/
*.log
