{
  "name": "agrivoice-api",
  "version": "0.1.0",
  "private": true,
  "description": "AgriVoice Fastify Node.js Application Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
